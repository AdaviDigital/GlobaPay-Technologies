# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://globapay:globapay@localhost:5432/globapay?schema=public

# --- Redis (sessions/queues in later phases) ---
REDIS_URL=redis://localhost:6379

# --- JWT (REQUIRED — the app refuses to start without these; see validate-env.ts) ---
# Generate each with: openssl rand -hex 32
# Do NOT reuse these two values as each other, and never commit real secrets.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Mail (leave blank to log OTPs/links to the console in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GlobaPay <no-reply@globapay.app>

# --- AI Assistant (optional — endpoints return 503 until this is set) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
